# Ghost — environment / secret reference
# Copy to .env (gitignored) or, in production, load these as Kubernetes Secret keys.
# NO real values live here or anywhere in the repo — every value below is a placeholder.
# In the live cluster these are injected via secretKeyRef from the `ghost-app-secrets`,
# `ghost-postgres-postgresql` and `ghost-redis` secrets (zero inline values in the manifests).

# --- Telegram ---
BOT_TOKEN=123456789:AA-your-telegram-bot-token
TELEGRAM_USER_ID=000000000              # the single Telegram user Ghost talks to

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Habitica ---
HABITICA_USER_ID=00000000-0000-0000-0000-000000000000
HABITICA_API_TOKEN=00000000-0000-0000-0000-000000000000

# --- Postgres (chart secret: ghost-postgres-postgresql / postgres-password) ---
POSTGRES_HOST=ghost-postgres-postgresql.ghost.svc.cluster.local
POSTGRES_PASSWORD=change-me-32-char-random

# --- Redis (chart secret: ghost-redis / redis-password) ---
REDIS_HOST=ghost-redis-master.ghost.svc.cluster.local
REDIS_PASSWORD=change-me-32-char-random

# --- FatSecret (3-legged OAuth 1.0a; tokens do not expire) ---
FATSECRET_CONSUMER_KEY=your-consumer-key
FATSECRET_CONSUMER_SECRET=your-consumer-secret
FATSECRET_ACCESS_TOKEN=your-delegated-access-token
FATSECRET_ACCESS_SECRET=your-delegated-access-secret

# --- Personalisation / config (kept out of code so the repo stays generic) ---
GHOST_USER_NAME=the user               # name Ghost uses for you
GHOST_TZ=UTC                           # IANA tz, e.g. Australia/Melbourne
GHOST_BRAND_PRIMARY=Personal Blog      # blog pipeline: primary brand
GHOST_BRAND_SECONDARY=Second Brand     # blog pipeline: secondary brand
GHOST_BRAND_DOMAIN=example.com         # blog pipeline: primary domain
GHOST_BRAND_VAULT_DIR=Blog             # Obsidian folder for blog drafts

# --- Paths / runtime ---
VAULT_PATH=/vault                      # Obsidian vault mount
GHOST_SYNC_DRYRUN=1                    # Habitica<->vault sync: 1=dry-run (log only), 0=live writes
